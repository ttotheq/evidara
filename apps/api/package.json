{
  "name": "@evidara/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test vitest run",
    "pretest": "npm run build:packages --prefix ../..",
    "test:unit": "NODE_ENV=test vitest run --config vitest.unit.config.ts",
    "pretest:unit": "npm run build:packages --prefix ../.."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/lib-storage": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@evidara/connectors-sdk": "0.1.0",
    "@evidara/contracts": "0.1.0",
    "@evidara/database": "0.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "file-type": "^22.0.1",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.21.1",
    "ioredis": "^5.11.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  }
}
