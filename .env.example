NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://evidara:evidara@localhost:5432/evidara
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evidara-evidence
S3_ACCESS_KEY=evidara
S3_SECRET_KEY=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=disabled
AI_MODEL=
SEED_OWNER_EMAIL=owner@evidara.local
SEED_OWNER_PASSWORD=replace-with-a-local-only-password
SEED_OWNER_NAME=Local Owner
SEED_ORGANIZATION_NAME=Evidara Local
SEED_ORGANIZATION_SLUG=evidara-local

# Evidence upload policy (defaults shown; uncomment to override)
# UPLOAD_MAX_BYTES=26214400
# UPLOAD_ALLOWED_MEDIA_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain,text/csv,application/json
# UPLOAD_TIMEOUT_SECONDS=120
# DOWNLOAD_URL_TTL_SECONDS=60

# Web capture policy (defaults shown; uncomment to override)
# CAPTURE_MAX_REDIRECTS=5
# CAPTURE_MAX_RESPONSE_BYTES=10485760
# CAPTURE_MAX_DECOMPRESSED_BYTES=52428800
# CAPTURE_TIMEOUT_SECONDS=30
# CAPTURE_ALLOWED_CONTENT_TYPES=text/html,application/xhtml+xml,text/plain
# CAPTURE_USER_AGENT=EvidaraCapture/1.0 (+https://github.com/evidara/evidara)
# Exact host:port entries exempt from SSRF blocking, for local test fixtures
# only. Ignored when NODE_ENV=production.
# CAPTURE_FIXTURE_ALLOWLIST=
